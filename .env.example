# Copy this file to .env and fill in the real values.
# .env is listed in .gitignore and must NEVER be committed.

# Pabbly Connect webhook — receives form submissions for automation
PABBLY_WEBHOOK_URL=your_pabbly_webhook_url_here

# KNEO CRM backend
CRM_ENDPOINT=https://your-backend.com/api/crm/leads
CRM_API_KEY=your_crm_api_key_here
