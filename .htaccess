# =============================================================================
#  KNEO Automation — Apache configuration (.htaccess for Hostinger)
#  Upload this file to the web root alongside index.html.
#
#  Method A: Internal Rewrites for Legacy & Campaign URLs
#  Serves new pages under original URLs with NO browser redirect (HTTP 200 OK).
#  Preserves all campaign UTMs, ad parameters, and prevents ad review/drop-off.
# =============================================================================

Options -Indexes
DirectoryIndex index.html

# -----------------------------------------------------------------------------
# Error page
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ---------------------------------------------------------------------------
  # Force HTTPS
  # ---------------------------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # ---------------------------------------------------------------------------
  # One canonical hostname. kneo.in is the host currently indexed, so www is
  # redirected to it.
  # ---------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # ---------------------------------------------------------------------------
  # mail.kneo.in -> main site. The mail subdomain points at this server, so
  # without this it serves a duplicate copy of the whole website. Only affects
  # web requests; email (MX/IMAP/SMTP) is unaffected.
  # ---------------------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^mail\.kneo\.in$ [NC]
  RewriteRule ^ https://kneo.in%{REQUEST_URI} [R=301,L]

  # ---------------------------------------------------------------------------
  # Old WordPress URLs -> matching new pages. The previous site used
  # ?page_id= addresses; without these rules every one of them served the
  # homepage and Google reported them as duplicates. Page IDs were mapped from
  # the Wayback Machine. The trailing ? drops the old query string.
  # ---------------------------------------------------------------------------
  RewriteCond %{QUERY_STRING} (^|&)page_id=93(&|$)
  RewriteRule ^(index\.php)?$ /mapp/mapp-eye/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=111(&|$)
  RewriteRule ^(index\.php)?$ /mapp/mapp-adept/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=118(&|$)
  RewriteRule ^(index\.php)?$ /mapp/mapp-zen/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=128(&|$)
  RewriteRule ^(index\.php)?$ /mapp/mapp-vita/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=141(&|$)
  RewriteRule ^(index\.php)?$ /mapp/mapp-trail/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=148(&|$)
  RewriteRule ^(index\.php)?$ /mapp/mapp-sprint/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=174(&|$)
  RewriteRule ^(index\.php)?$ /services/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=192(&|$)
  RewriteRule ^(index\.php)?$ /services/plc-hmi-scada-robot-programming/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=223(&|$)
  RewriteRule ^(index\.php)?$ /services/onsite-commissioning/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=(243|343)(&|$)
  RewriteRule ^(index\.php)?$ /industrial-automation/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=509(&|$)
  RewriteRule ^(index\.php)?$ /faq/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)page_id=537(&|$)
  RewriteRule ^(index\.php)?$ /contact/? [R=301,L]

  # Any other WordPress query URL (?page_id=, ?p=, ?tag=, ?cat=) and /tag/... -> home
  RewriteCond %{QUERY_STRING} (^|&)(page_id|p|tag|cat)=
  RewriteRule ^(index\.php)?$ /? [R=301,L]
  RewriteRule ^tag/ /? [R=301,L]

  # ---------------------------------------------------------------------------
  # Add the trailing slash to real directories, so /about resolves to /about/
  # exactly as it does on the current site. Only fires when the directory
  # actually exists, so it cannot affect anything this site does not serve.
  # ---------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # ---------------------------------------------------------------------------
  # Ensure trailing slash on legacy product routes so relative assets resolve
  # ---------------------------------------------------------------------------
  RewriteRule ^products/(mapp-[a-z]+|pfd|control-plan|digital-inspection|cbm|preventive-maintenance|ems|gage-management|incoming-quality)$ /products/$1/ [R=301,L,QSA]

  # ---------------------------------------------------------------------------
  # Campaign & Legacy Routes — Internal Rewrites (Method A)
  # Serves new pages under original URLs with NO browser redirect (HTTP 200 OK).
  # Preserves all campaign UTMs, ad parameters, and prevents ad review/drop-off.
  # ---------------------------------------------------------------------------
  # MAPP modules (formerly under /products/)
  RewriteRule ^products/mapp-eye/?$ /mapp/mapp-eye/index.html [L,QSA]
  RewriteRule ^products/mapp-trail/?$ /mapp/mapp-trail/index.html [L,QSA]
  RewriteRule ^products/mapp-adept/?$ /mapp/mapp-adept/index.html [L,QSA]
  RewriteRule ^products/mapp-sprint/?$ /mapp/mapp-sprint/index.html [L,QSA]
  RewriteRule ^products/mapp-vita/?$ /mapp/mapp-vita/index.html [L,QSA]
  RewriteRule ^products/mapp-zen/?$ /mapp/mapp-zen/index.html [L,QSA]

  # Quality 4.0 / Inspection / APQP legacy routes
  RewriteRule ^products/pfd/?$ /products/drawing-inspection-workflow/index.html [L,QSA]
  RewriteRule ^products/control-plan/?$ /products/drawing-inspection-workflow/index.html [L,QSA]
  RewriteRule ^products/digital-inspection/?$ /products/drawing-inspection-workflow/index.html [L,QSA]
  RewriteRule ^products/gage-management/?$ /products/drawing-inspection-workflow/index.html [L,QSA]
  RewriteRule ^products/incoming-quality/?$ /products/drawing-inspection-workflow/index.html [L,QSA]

  # Maintenance & IIoT legacy routes
  RewriteRule ^products/cbm/?$ /mapp/mapp-vita/index.html [L,QSA]
  RewriteRule ^products/preventive-maintenance/?$ /mapp/mapp-vita/index.html [L,QSA]
  RewriteRule ^products/ems/?$ /mapp/mapp-eye/index.html [L,QSA]

  # ---------------------------------------------------------------------------
  # Old flat URLs, in case anything ever requested the .html form directly
  # Checks THE_REQUEST so internal subrequests to index.html are not redirected.
  # ---------------------------------------------------------------------------
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteCond %{REQUEST_URI} !^/404\.html$
  RewriteRule ^ /%1/ [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# Compression — the site is text-heavy and compresses roughly 4x
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Caching. HTML stays short-lived so content edits appear quickly; static
# assets are cached hard.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/xml           "access plus 1 day"
  ExpiresByType text/plain                "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Baseline security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# -----------------------------------------------------------------------------
# Correct MIME types
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/svg+xml   .svg
  AddType application/xml .xml
  AddType video/mp4       .mp4
  AddType font/woff2      .woff2
</IfModule>
